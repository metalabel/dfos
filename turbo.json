{
  "$schema": "https://turbo.build/schema.json",
  // turbo >=2.11 writes a managed block into AGENTS.md whenever it detects an
  // agent. AGENTS.md is hand-authored canon, so opt out.
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["build/**", "dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "src/**", "tsconfig*.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "src/**", "tests/**", "tsconfig*.json", "vitest.config.*"]
    },
    "typecheck": {
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "src/**/*.ts", "tests/**/*.ts", "tsconfig*.json"]
    },
    "lint": {
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "src/**", "tests/**", "tsconfig*.json", "*.config.*"]
    },
    "format": {
      "cache": false
    }
  }
}
