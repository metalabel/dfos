{
  "name": "@metalabel/dfos-client",
  "version": "0.46.0",
  "type": "module",
  "description": "DFOS Client — the client-side kit for participating in the protocol: resolve, verify, prove. Fetch, resolve, verify-orchestration and cache over untrusted relays, plus the SIWD and API-AUTH proof surfaces. Holds no keys; all crypto truth comes from @metalabel/dfos-protocol",
  "license": "MIT",
  "author": "Metalabel <hello@metalabel.com> (https://metalabel.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/metalabel/dfos.git",
    "directory": "packages/dfos-client"
  },
  "homepage": "https://protocol.dfos.com",
  "keywords": [
    "dfos",
    "client",
    "did",
    "verifiable",
    "resolve",
    "siwd",
    "ed25519",
    "jws",
    "metalabel"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./api-auth": "./src/api-auth.ts",
    "./siwd": "./src/siwd.ts",
    "./store": "./src/store/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./api-auth": {
        "import": "./dist/api-auth.js",
        "types": "./dist/api-auth.d.ts"
      },
      "./siwd": {
        "import": "./dist/siwd.js",
        "types": "./dist/siwd.d.ts"
      },
      "./store": {
        "import": "./dist/store/index.js",
        "types": "./dist/store/index.d.ts"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "typecheck": "node ../../node_modules/typescript7/bin/tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@metalabel/dfos-protocol": "^0.46.0",
    "@metalabel/dfos-web-relay": "^0.46.0"
  },
  "devDependencies": {
    "@metalabel/dfos-protocol": "workspace:*",
    "@metalabel/dfos-web-relay": "workspace:*",
    "@types/node": "^24.10.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
