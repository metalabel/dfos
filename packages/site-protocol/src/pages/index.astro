---
import Base from '../layouts/Base.astro';
import { specs } from '../content/specs';
import { navLinks, primaryNav, headerLabel } from '../data/nav';

// The spec wall, grouped by the registry's tier taxonomy. Reading order is the
// order here; within a tier, tiles keep the registry's canonical array order.
const specTiers = [
  { grid: 'core', label: 'Core' },
  { grid: 'reference', label: 'Relay and integrations' },
  { grid: 'guarantees', label: 'Guarantees' },
] as const;

// A public content chain served by relay.dfos.com. The explorer re-runs the
// signature, chain, and document-hash checks in the browser, so the first
// action the homepage offers is watching those checks run against real bytes.
const signedRecordUrl =
  'https://explore.dfos.com/#/content/222978eakt29ner7zv8zhz763drzf34';
---

<Base
  title="DFOS Protocol"
  description="DFOS is an open protocol for identities, signed records, and delegated permissions that any compatible application can verify for itself."
  landing={true}
>
  <!-- ═══ Hero ═══ -->
  <section class="hero">
    <header class="site-header site-header--landing">
      <a href="/" class="logo">
        <img src="/dfos-logo-green.svg" alt="DFOS" />
      </a>
      <nav>
        {primaryNav.map((link) => <a href={link.href}>{headerLabel(link)}</a>)}
      </nav>
    </header>

    <div class="hero-overlay">
      <h1 class="hero-declaration">Identity and authorship, <span class="green">beyond the platform.</span></h1>
      <p class="hero-pitch">
        DFOS is an open protocol for identities, signed records, and delegated
        permissions that any compatible application can verify for itself.
      </p>
    </div>

    <div class="hero-below">
      <ul class="action-list action-list--hero">
        <li>Use the same identity across applications.</li>
        <li>Give your work a verifiable history.</li>
        <li>Let collaborators or software act within permissions you grant, without your keys.</li>
      </ul>
      <div class="hero-cta">
        <a href={signedRecordUrl} class="hero-cta-link">Explore a signed record &rarr;</a>
        <a href="/integrations" class="hero-cta-link">Start building &rarr;</a>
      </div>
    </div>
  </section>

  <!-- ═══ Identity ═══ -->
  <section class="dark-section">
    <div class="dark-section-inner">
      <span class="section-label">I D E N T I T Y</span>
      <h2>One identity. More than one application.</h2>
      <div class="section-body">
        <p>
          A DFOS identity begins with a signed record, not a registration in a
          central directory. Its <a href="/did-method"><code>did:dfos</code></a>
          identifier is derived from that first operation, and it stays the same
          as the identity's keys and services change. Every later key proves
          possession of itself, bound to its role and its position in the chain.
        </p>
        <p>
          An application verifies a sign-in against that signed history rather
          than against an account at one host. A domain you control can point to
          the identity, with a matching claim recorded on the identity itself.
        </p>
      </div>
      <p class="section-cta-row">
        <a href="/did-method" class="section-cta">The did:dfos method &rarr;</a>
        <a href="/integrations" class="section-cta">Sign in and API auth &rarr;</a>
      </p>
    </div>
  </section>

  <!-- ═══ Signed records ═══ -->
  <section class="two-worlds-section">
    <div class="two-worlds-inner">
      <div class="two-worlds-card" id="tilt-card">
        <img src="/card-hands.png" alt="" class="two-worlds-card-img" />
      </div>
      <div class="two-worlds-text">
        <span class="section-label">S I G N E D &nbsp; R E C O R D S</span>
        <h2>The proof can travel without the document.</h2>
        <p>
          A signed content record names its document by cryptographic hash.
          Anyone holding the record and the identity history it references can
          check who signed it without opening the document.
        </p>
        <p>
          A reader who does receive the document can check that the bytes match
          the commitment. Those are two separate results: signed attribution is
          one check, document integrity is another.
        </p>
        <p>
          A document can be public or served only to selected readers, and
          distributing its signed record does not require distributing its
          contents. The protocol commits to a document by hash. It does not
          encrypt, and whoever serves a document can read it.
        </p>
        <p class="section-cta-row">
          <a href="/content-model" class="section-cta">The content model &rarr;</a>
          <a href="/relay" class="section-cta">Relays and the content plane &rarr;</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ Permissions ═══ -->
  <section class="dark-section">
    <div class="dark-section-inner">
      <span class="section-label">P E R M I S S I O N S</span>
      <h2>Delegate a task. Keep your keys.</h2>
      <div class="section-body">
        <p>
          Give a collaborator permission to update one content chain. Give an
          application access to one resource. A permission is a signed
          credential naming the identity it authorizes, and for credential-gated
          API calls that party proves possession of its own key and binds the
          proof to the particular request.
        </p>
        <p>
          Delegation is linear and narrowing: each hop can drop resources, drop
          actions, and shorten expiry, and it can never widen what it was given.
          A credential expires at the time it names and can be revoked before
          then, and a verifier enforces a revocation once it holds it.
        </p>
      </div>
      <p class="section-cta-row">
        <a href="/credentials" class="section-cta">Credentials &rarr;</a>
        <a href="/guarantees" class="section-cta">What revocation reaches &rarr;</a>
      </p>
    </div>
  </section>

  <!-- ═══ Get Started ═══ -->
  <section class="landing-section get-started" id="get-started">
    <span class="section-label">G E T &nbsp; S T A R T E D</span>
    <h2>Start locally. Connect when you need to.</h2>
    <p class="get-started-intro">
      Create identities, sign records, and verify them on your own machine. The
      CLI signs and stores operations locally, and publishing to a relay is a
      separate, explicit step. A relay is HTTP storage and exchange for signed
      records, with optional document hosting, and anyone can run one. You do
      not need an account on the DFOS platform to begin.
      <a href="/cli">Full documentation</a>.
    </p>

    <ul class="action-list">
      <li>Create an identity on your own machine.</li>
      <li>Add a key your host never receives.</li>
      <li>Continue a signed history on another relay, from the last operation your controller key controlled.</li>
    </ul>

    <div class="install-primary">
      <div class="install-code">
        <code>curl -sSL https://protocol.dfos.com/install.sh | sh</code>
        <button class="install-copy" aria-label="Copy command">copy</button>
      </div>
      <p class="install-alt">
        Also available via
        <code>brew install metalabel/tap/dfos</code>
        and
        <code>docker pull ghcr.io/metalabel/dfos</code>
      </p>
    </div>

    <div class="quickstart-block">
      <div class="install-label">Quickstart</div>
      <pre class="quickstart-pre"><code set:html={`<span class="qs-comment"># create the seed your keys derive from, and write the phrase down</span>
dfos vault create personal

<span class="qs-comment"># create your identity — one key, minted from that vault</span>
dfos identity create --name myname

<span class="qs-comment"># sign your first record — every signing command names the identity it acts as</span>
echo '{"$schema":"https://schemas.dfos.com/post/v1","format":"short-post","body":"gm"}' | dfos --as myname content create -

<span class="qs-comment"># tired of typing it: set the standing default</span>
dfos config set default-identity myname

<span class="qs-comment"># see it</span>
dfos content list

<span class="qs-comment"># re-verify the chain, locally</span>
dfos content verify &lt;contentId&gt;`} /></pre>
    </div>
  </section>

  <!-- ═══ Key Separator ═══ -->
  <section class="key-separator">
    <img src="/key-icon-green.svg" alt="" class="key-separator-icon" />
  </section>

  <!-- ═══ Trust model ═══ -->
  <section class="dark-section">
    <div class="dark-section-inner">
      <span class="section-label">T R U S T &nbsp; M O D E L</span>
      <h2>Know what you are verifying.</h2>
      <div class="section-body">
        <p>
          Verification answers who signed a record and whether a document
          matches its commitment. It does not establish that a signed claim is
          true: the chain shows what was signed, never who was at the keyboard.
        </p>
        <p>
          The protocol does not encrypt documents, and a relay operator reads
          every blob it stores. Nothing obliges a relay to keep your chain. An
          identity chain is linear per view, nothing arbitrates between relays
          that admitted different successors, and which relay you read is which
          view you get.
        </p>
        <p>
          The DFOS platform holds a signing key for your account by default, so
          ordinary use needs no key management, and you can add keys it never
          holds. Keep your own copies of your chain and your documents.
        </p>
      </div>
      <p class="section-cta-row">
        <a href="/guarantees" class="section-cta">The guarantees and trust model &rarr;</a>
      </p>
    </div>
  </section>

  <!-- ═══ Specifications ═══ -->
  <section class="landing-section">
    <span class="section-label">S P E C I F I C A T I O N S</span>
    <h2>Open specifications. Working implementations.</h2>

    <div class="credibility-strip">
      <span>MIT License</span>
      <span class="credibility-dot">&middot;</span>
      <span>Powers the <a href="https://dfos.com">DFOS platform</a></span>
      <span class="credibility-dot">&middot;</span>
      <span>TypeScript &middot; Go &middot; Python &middot; Rust &middot; Swift</span>
    </div>
    <p class="credibility-sub">
      Verification implementations in five languages, checked against the same
      deterministic test vectors. <a href="/spec">The protocol specification</a>
      is the single source of truth.
    </p>

    <span class="section-label section-label--spaced">R E A D &nbsp; T H E &nbsp; P R O T O C O L</span>

    {
      specTiers.map((tier) => (
        <Fragment>
          <span class="spec-tier-label">{tier.label}</span>
          <div class="spec-links spec-links--quad spec-links--tier">
            {specs.filter((spec) => spec.grid === tier.grid).map(({ slug, title, listTitle, tile }) => (
              <a href={slug} class="spec-link">
                <span class="spec-link-title">{listTitle ?? title}</span>
                <span class="spec-link-desc" set:html={tile} />
              </a>
            ))}
          </div>
        </Fragment>
      ))
    }

    <span class="section-label section-label--spaced">U S E &nbsp; I T</span>

    <div class="spec-links">
      {
        specs.filter((spec) => spec.grid === 'use').map(({ slug, title, listTitle, tile }) => (
          <a href={slug} class="spec-link">
            <span class="spec-link-title">{listTitle ?? title}</span>
            <span class="spec-link-desc" set:html={tile} />
          </a>
        ))
      }
      <a href="/overview" class="spec-link">
        <span class="spec-link-title">Why</span>
        <span class="spec-link-desc">The requirement the protocol answers to, the design principles, what it is and isn't</span>
      </a>
    </div>

    <hr class="section-divider" />

    <ul class="resource-list">
      <li>
        <a href="/faq">FAQ</a>
        <span class="desc">&mdash; design decisions, AT Protocol comparison, blockchain identity</span>
      </li>
      <li>
        <a href="https://docs.dfos.com/docs/developers/sign-in-with-dfos/setup">Building an app?</a>
        <span class="desc">&mdash; the platform's task-oriented Sign In With DFOS guide</span>
      </li>
      <li>
        <a href="https://github.com/metalabel/dfos">GitHub</a>
        <span class="desc">&mdash; metalabel/dfos &mdash; MIT License</span>
      </li>
      <li>
        <a href="https://github.com/metalabel/dfos/releases/latest">Releases</a>
        <span class="desc">&mdash; pre-built binaries for all platforms</span>
      </li>
      <li>
        <a href="https://explore.dfos.com">explore.dfos.com</a>
        <span class="desc">&mdash; chain explorer &mdash; client-side, verify-in-tab</span>
      </li>
      <li>
        <a href="https://www.npmjs.com/package/@metalabel/dfos-protocol">npm</a>
        <span class="desc">&mdash; TypeScript protocol library (see also: <a href="https://www.npmjs.com/package/@metalabel/dfos-web-relay">dfos-web-relay</a>, <a href="https://www.npmjs.com/package/@metalabel/dfos-client">dfos-client</a>)</span>
      </li>
      <li>
        <a href="https://schemas.dfos.com">schemas.dfos.com</a>
        <span class="desc">&mdash; JSON Schema definitions</span>
      </li>
      <li>
        <a href="/llms-full.txt">llms-full.txt</a>
        <span class="desc">&mdash; full protocol content as plain text</span>
      </li>
    </ul>
  </section>

  <script is:inline>
    document.querySelectorAll('.install-copy').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var code = btn.parentElement.querySelector('code').textContent;
        navigator.clipboard.writeText(code).then(function () {
          var prev = btn.textContent;
          btn.textContent = 'copied';
          setTimeout(function () { btn.textContent = prev; }, 1500);
        });
      });
    });

    // scroll-driven image brightness
    (function () {
      var targets = [];
      document.querySelectorAll('.split-image, .key-separator').forEach(function (el) {
        targets.push({ el: el, mode: 'contain' });
      });
      document.querySelectorAll('.closing-image').forEach(function (el) {
        targets.push({ el: el, mode: 'enter' });
      });
      targets = targets.filter(function (t) { return t.el; });

      function update() {
        var vh = window.innerHeight;
        targets.forEach(function (t) {
          var rect = t.el.getBoundingClientRect();
          var ratio;
          if (t.mode === 'enter') {
            var entered = vh - rect.top;
            ratio = Math.min(1, Math.max(0, entered / (rect.height * 0.5)));
          } else {
            var visibleTop = Math.max(0, rect.top);
            var visibleBottom = Math.min(vh, rect.bottom);
            var visibleHeight = Math.max(0, visibleBottom - visibleTop);
            var visibleRatio = visibleHeight / rect.height;
            ratio = Math.min(1, visibleRatio / 0.8);
          }
          ratio = ratio * ratio;
          t.el.style.setProperty('--scroll-brightness', ratio.toFixed(3));
        });
        requestAnimationFrame(update);
      }
      update();
    })();

    // 3D tilt card
    (function () {
      var card = document.getElementById('tilt-card');
      if (!card) return;
      card.addEventListener('mousemove', function (e) {
        var rect = card.getBoundingClientRect();
        var x = (e.clientX - rect.left) / rect.width;
        var y = (e.clientY - rect.top) / rect.height;
        var rotateY = (x - 0.5) * 20;
        var rotateX = (0.5 - y) * 20;
        card.style.transform = 'perspective(800px) rotateX(' + rotateX + 'deg) rotateY(' + rotateY + 'deg) scale(1.03)';
        card.style.boxShadow = '0 ' + (20 + rotateX * 2) + 'px 60px rgba(0,0,0,0.6)';
      });
      card.addEventListener('mouseleave', function () {
        card.style.transform = 'perspective(800px) rotateX(0) rotateY(0) scale(1)';
        card.style.boxShadow = '0 20px 60px rgba(0,0,0,0.5)';
      });
    })();

    // Mobile scroll tilt for card
    (function () {
      if (window.innerWidth > 768) return;
      var card = document.getElementById('tilt-card');
      if (!card) return;
      function update() {
        var rect = card.getBoundingClientRect();
        var vh = window.innerHeight;
        var center = (rect.top + rect.height / 2) / vh;
        var rotateX = (center - 0.5) * -18;
        var rotateY = Math.sin(center * 3) * 10;
        card.style.transform = 'perspective(800px) rotateX(' + rotateX + 'deg) rotateY(' + rotateY + 'deg)';
        requestAnimationFrame(update);
      }
      update();
    })();
  </script>

  <!-- ═══ Closing ═══ -->
  <footer class="closing">
    <div class="closing-image">
      <img src="/painting-angel.jpg" alt="" />
    </div>
    <div class="closing-content">
      <img src="/key-icon-green.svg" alt="" class="closing-key" />
      <div class="closing-mark">DFOS Protocol</div>
      <nav class="closing-nav">
        {navLinks.filter((link) => link.href !== '/').map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
      <p class="closing-credits">Yancey &middot; Ilya &middot; Brandon &middot; Lena</p>
      <p class="closing-credits"><a href="https://github.com/metalabel/dfos/blob/main/LICENSE">MIT License</a> &middot; 2026</p>
    </div>
  </footer>
</Base>
