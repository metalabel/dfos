---
import fs from 'node:fs';
import { specEntry } from '../content/specs';
import SpecPage from '../layouts/SpecPage.astro';

const source = fs.readFileSync('../dfos-cli/CLI.md', 'utf-8');
const entry = specEntry('/cli');
---

<SpecPage
  title={entry.title}
  description={entry.metaDescription}
  path="/cli"
  source={source}
/>
