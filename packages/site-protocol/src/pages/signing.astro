---
import fs from 'node:fs';
import { specEntry } from '../content/specs';
import SpecPage from '../layouts/SpecPage.astro';

const source = fs.readFileSync('../../specs/SIGNING.md', 'utf-8');
const entry = specEntry('/signing');
---

<SpecPage
  title={entry.title}
  description={entry.metaDescription}
  path="/signing"
  source={source}
/>
