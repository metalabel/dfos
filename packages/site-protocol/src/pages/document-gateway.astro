---
import fs from 'node:fs';
import { specEntry } from '../content/specs';
import SpecPage from '../layouts/SpecPage.astro';

const source = fs.readFileSync('../../specs/DOCUMENT-GATEWAY.md', 'utf-8');
const entry = specEntry('/document-gateway');
---

<SpecPage
  title={entry.title}
  description={entry.metaDescription}
  path="/document-gateway"
  source={source}
/>
