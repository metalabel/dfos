---
import fs from 'node:fs';
import { specEntry } from '../content/specs';
import SpecPage from '../layouts/SpecPage.astro';

const source = fs.readFileSync('../../specs/SIWD.md', 'utf-8');
const entry = specEntry('/siwd');
---

<SpecPage
  title={entry.title}
  description={entry.metaDescription}
  path="/siwd"
  source={source}
>
  <div slot="intro" class="siwd-intro-note dim">
    <p>
      This is the normative Sign In With DFOS spec. Building an app? The task-oriented guide lives at
      <a href="https://docs.dfos.com/docs/developers/sign-in-with-dfos/setup">docs.dfos.com</a>.
    </p>
  </div>
</SpecPage>
