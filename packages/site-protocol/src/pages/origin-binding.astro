---
import fs from 'node:fs';
import { specEntry } from '../content/specs';
import SpecPage from '../layouts/SpecPage.astro';

const source = fs.readFileSync('../../specs/ORIGIN-BINDING.md', 'utf-8');
const entry = specEntry('/origin-binding');
---

<SpecPage
  title={entry.title}
  description={entry.metaDescription}
  path="/origin-binding"
  source={source}
/>
