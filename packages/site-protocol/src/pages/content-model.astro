---
import fs from 'node:fs';
import { specEntry } from '../content/specs';
import SpecPage from '../layouts/SpecPage.astro';

const source = fs.readFileSync('../../specs/CONTENT-MODEL.md', 'utf-8');
const entry = specEntry('/content-model');
---

<SpecPage
  title={entry.title}
  description={entry.metaDescription}
  path="/content-model"
  source={source}
/>
