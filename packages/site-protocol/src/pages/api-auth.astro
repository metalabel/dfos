---
import fs from 'node:fs';
import { specEntry } from '../content/specs';
import SpecPage from '../layouts/SpecPage.astro';

const source = fs.readFileSync('../../specs/API-AUTH.md', 'utf-8');
const entry = specEntry('/api-auth');
---

<SpecPage
  title={entry.title}
  description={entry.metaDescription}
  path="/api-auth"
  source={source}
/>
