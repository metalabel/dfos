---
import fs from 'node:fs';
import { specEntry } from '../content/specs';
import SpecPage from '../layouts/SpecPage.astro';

const source = fs.readFileSync('../../specs/CREDITS.md', 'utf-8');
const entry = specEntry('/credits');
---

<SpecPage
  title={entry.title}
  description={entry.metaDescription}
  path="/credits"
  source={source}
/>
