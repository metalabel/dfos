---
import fs from 'node:fs';
import { specEntry } from '../content/specs';
import SpecPage from '../layouts/SpecPage.astro';

const source = fs.readFileSync('../../deploy/QUICKSTART.md', 'utf-8');
const entry = specEntry('/deploy');
---

<SpecPage
  title={entry.title}
  description={entry.metaDescription}
  path="/deploy"
  source={source}
/>
