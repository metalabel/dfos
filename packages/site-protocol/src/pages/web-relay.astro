---
import fs from 'node:fs';
import { specEntry } from '../content/specs';
import SpecPage from '../layouts/SpecPage.astro';

const source = fs.readFileSync('../../specs/WEB-RELAY.md', 'utf-8');
const entry = specEntry('/web-relay');
---

<SpecPage
  title={entry.title}
  description={entry.metaDescription}
  path="/web-relay"
  source={source}
/>
