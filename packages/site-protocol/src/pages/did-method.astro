---
import fs from 'node:fs';
import { specEntry } from '../content/specs';
import SpecPage from '../layouts/SpecPage.astro';

const source = fs.readFileSync('../../specs/DID-METHOD.md', 'utf-8');
const entry = specEntry('/did-method');
---

<SpecPage
  title={entry.title}
  description={entry.metaDescription}
  path="/did-method"
  source={source}
/>
