---
import fs from 'node:fs';
import { specEntry } from '../content/specs';
import SpecPage from '../layouts/SpecPage.astro';

const source = fs.readFileSync('../../specs/GUARANTEES.md', 'utf-8');
const entry = specEntry('/guarantees');
---

<SpecPage
  title={entry.title}
  description={entry.metaDescription}
  path="/guarantees"
  source={source}
/>
