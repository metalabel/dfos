---
import fs from 'node:fs';
import { specEntry } from '../content/specs';
import SpecPage from '../layouts/SpecPage.astro';

const source = fs.readFileSync('../../specs/PROTOCOL.md', 'utf-8');
const entry = specEntry('/spec');
---

<SpecPage
  title={entry.title}
  description={entry.metaDescription}
  path="/spec"
  source={source}
/>
