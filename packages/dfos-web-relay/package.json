{
  "name": "@metalabel/dfos-web-relay",
  "version": "0.42.0",
  "type": "module",
  "description": "DFOS Web Relay — verifying HTTP relay for identity chains, content chains, and content blobs",
  "license": "MIT",
  "author": "Metalabel <hello@metalabel.com> (https://metalabel.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/metalabel/dfos.git",
    "directory": "packages/dfos-web-relay"
  },
  "homepage": "https://protocol.dfos.com",
  "keywords": [
    "dfos",
    "relay",
    "web-relay",
    "hono",
    "ed25519",
    "jws",
    "did",
    "verifiable",
    "identity",
    "content-addressing",
    "metalabel"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/serve.ts",
    "./peer-client": "./src/peer-client.ts",
    "./openapi.json": "./openapi.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./node": {
        "import": "./dist/serve.js",
        "types": "./dist/serve.d.ts"
      },
      "./peer-client": {
        "import": "./dist/peer-client.js",
        "types": "./dist/peer-client.d.ts"
      },
      "./openapi.json": "./openapi.json"
    }
  },
  "files": [
    "dist",
    "openapi.yaml",
    "openapi.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "gen:openapi": "node scripts/generate-openapi-json.mjs",
    "build": "pnpm gen:openapi && tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@metalabel/dfos-protocol": "^0.42.0",
    "hono": "^4.12.23"
  },
  "devDependencies": {
    "@metalabel/dfos-protocol": "workspace:*",
    "@types/node": "^24.10.4",
    "hono": "^4.12.23",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "vitest": "^4.1.8",
    "yaml": "^2.8.2"
  }
}
